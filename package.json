{
  "name": "@summitml/routlet",
  "version": "0.1.0",
  "description": "Named dev services. Any port. Any network.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/summit-ml/routlet.git"
  },
  "homepage": "https://github.com/summit-ml/routlet#readme",
  "bugs": {
    "url": "https://github.com/summit-ml/routlet/issues"
  },
  "keywords": [
    "tailscale",
    "dev-server",
    "proxy",
    "https",
    "localhost",
    "ports"
  ],
  "type": "module",
  "bin": {
    "routlet": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "build:helper": "cd helper && go build -o bin/routlet-helper .",
    "build:packages": "node scripts/build-packages.mjs",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build",
    "set-version": "node scripts/set-version.mjs",
    "prepublishOnly": "node scripts/check-publishable.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
